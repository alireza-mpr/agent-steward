# Copy to .env (ignored by git) and fill in the values from your tenant.
# These are identifiers, not secrets. The secrets live in secrets/ (also ignored).

# Entra admin center > Entra ID > Overview > Tenant ID
TENANT_ID=<TENANT_ID>

# Entra admin center > Entra ID > Agents > Agent blueprints > agent-steward-guardian: its app ID
GUARDIAN_BLUEPRINT_APP_ID=<GUARDIAN_BLUEPRINT_APP_ID>

# Entra admin center > Entra ID > Agents > Agent identities > agent-steward-guardian-01: its app ID
GUARDIAN_AGENT_APP_ID=<GUARDIAN_AGENT_APP_ID>

# Entra admin center > Entra ID > Agents > Agent identities > agent-steward-guardian-norole-01: its app ID
# (a test agent with no role on the Identity API, for the live negative test)
GUARDIAN_NOROLE_AGENT_APP_ID=<GUARDIAN_NOROLE_AGENT_APP_ID>

# Output identityApiAppId of setup/bicep/identity-api.bicep
IDENTITY_API_APP_ID=<IDENTITY_API_APP_ID>

# Output agentDisableCliAppId of setup/bicep/agent-disable-approvers.bicep (the public client app of the `approve` command, FR7)
AGENT_DISABLE_CLI_APP_ID=<AGENT_DISABLE_CLI_APP_ID>

# Output testClientAppId of setup/bicep/test-client.bicep (a plain app for the live negative test)
TEST_CLIENT_APP_ID=<TEST_CLIENT_APP_ID>
